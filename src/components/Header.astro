---
/* En-tete.
 *
 *  Trois zones et rien de plus, comme chez Fenty : le logo, la navigation,
 *  les actions.
 *
 *  LE LOGO EST TOUJOURS DANS LA BARRE, ET IL NE S'ANIME PAS.
 *  Une premiere version reprenait le geste de The Ordinary : sur l'accueil,
 *  le logo vivait dans la banniere et venait se poser dans l'en-tete au
 *  defilement. Ecarte le 2026-09-04. Deux raisons :
 *   - la marque disparaissait du haut de la page a l'endroit exact ou une
 *     visiteuse cherche a savoir chez qui elle est ;
 *   - le meme logo apparaissait deux fois sur l'accueil, une fois dans la
 *     banniere et une fois dans la barre, ce qui se voyait a la capture.
 *
 *  Il n'y a donc plus de propriete logoInHero, plus d'observateur, et plus
 *  d'etat data-revealed : le logo est rendu par le serveur et ne bouge
 *  jamais. Un element de moins a synchroniser, c'est un bug de moins.
 */
import { getTheme, getContent } from '../lib/theme.js';
import { listCategories } from '../lib/products.js';
const theme = await getTheme();
const content = await getContent();

/* Le menu = les liens du fichier de theme, avec les rayons de la boutique
   inseres apres le premier (<< Tous les produits >>). */
const rayons = (await listCategories()).map((r) => ({
  libelle: r.libelle,
  href: `/produits/?rayon=${r.cle}`,
}));
const [tous, ...reste] = content.nav;
const nav = [tous, ...rayons, ...reste];

const logo = theme.identity.logoText ?? theme.identity.name;
const waLink = theme.identity.whatsapp
  ? `https://wa.me/${theme.identity.whatsapp.replace(/\D/g, '')}`
  : null;
---

{content.announcement?.actif && (
  <div class="announcement">
    <div class="container">
      <p>{content.announcement.texte}</p>
    </div>
  </div>
)}

<header class="header" id="site-header">
  <div class="container header__inner">
    <a href="/" class="header__logo" id="header-logo">
      {theme.identity.logoImage
        ? <img src={theme.identity.logoImage} alt={theme.identity.name} height="26" />
        : <span class="header__logo-text">{logo}</span>}
    </a>

    <nav class="header__nav" aria-label="Navigation principale">
      {nav.map((item) => (
        <a href={item.href} class="link">{item.libelle}</a>
      ))}
    </nav>

    <div class="header__actions">
      {waLink && (
        <a href={waLink} class="icon-btn" target="_blank" rel="noopener" aria-label="Nous écrire sur WhatsApp">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 0C5.373 0 0 5.373 0 12c0 2.124.554 4.118 1.528 5.845L.057 23.543a.5.5 0 0 0 .605.605l5.698-1.471A11.95 11.95 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22a9.95 9.95 0 0 1-5.154-1.413l-.369-.217-3.828.988.995-3.758-.235-.383A9.953 9.953 0 0 1 2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10zm5.472-7.618c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
          </svg>
        </a>
      )}

      <button class="icon-btn" id="cart-open" aria-label={content.ui.panier} aria-haspopup="dialog">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
          <path d="M4 7h16l-1.2 13.2A2 2 0 0 1 16.8 22H7.2a2 2 0 0 1-2-1.8L4 7z" />
          <path d="M8.5 10V6a3.5 3.5 0 0 1 7 0v4" />
        </svg>
        <span class="header__count" id="cart-count" hidden>0</span>
      </button>

      <button class="icon-btn header__burger" id="menu-open" aria-label="Ouvrir le menu" aria-expanded="false">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
          <path d="M4 8h16M4 16h16" />
        </svg>
      </button>
    </div>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" hidden>
  <nav class="container mobile-menu__nav" aria-label="Navigation mobile">
    {nav.map((item) => (
      <a href={item.href} class="mobile-menu__link">{item.libelle}</a>
    ))}
  </nav>
</div>

<style>
  .announcement {
    background: var(--color-primary);
    color: var(--color-on-primary);
    padding-block: var(--space-3);
    text-align: center;
  }

  .announcement p {
    font-size: var(--text-m);
    letter-spacing: 0.02em;
    line-height: 1.3;
  }

  .header {
    position: sticky;
    top: 0;
    z-index: 200;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    transition: background-color var(--duration-base) var(--ease-out),
                border-color var(--duration-base) var(--ease-out);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    min-height: var(--header-height);
  }

  .header__logo {
    flex-shrink: 0;
  }

  .header__logo-text {
    font-family: var(--font-display);
    font-weight: var(--font-display-weight);
    font-size: var(--h3);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text);
  }

  .header__nav {
    display: none;
    gap: var(--space-8);

    @media (width >= 900px) {
      display: flex;
    }
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .header__count {
    position: absolute;
    top: 4px;
    right: 2px;
    min-width: 17px;
    height: 17px;
    padding-inline: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    /* Pastille en noir de marque, pas en couleur d'accent : meme regle que
       les boutons. */
    background: var(--color-primary);
    color: var(--color-on-primary);
    border-radius: var(--radius-button);
    font-size: 11px;
    font-weight: var(--weight-semibold);
    line-height: 1;
  }

  .header__burger {
    @media (width >= 900px) {
      display: none;
    }
  }

  .mobile-menu {
    position: sticky;
    top: var(--header-height);
    z-index: 190;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);

    @media (width >= 900px) {
      display: none;
    }
  }

  .mobile-menu__nav {
    display: flex;
    flex-direction: column;
    padding-block: var(--space-4);
  }

  .mobile-menu__link {
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text);

    &:last-child {
      border-bottom: none;
    }

    &:hover {
      color: color-mix(in oklab, var(--color-text) 68%, var(--color-bg));
    }
  }
</style>

<script>
  /* Le logo n'a plus de script : il est rendu par le serveur et reste en
     place. Voir la note en tete de fichier. */

  // Menu mobile
  const menuBtn = document.getElementById('menu-open');
  const menu = document.getElementById('mobile-menu');
  menuBtn?.addEventListener('click', () => {
    const open = menu.hidden;
    menu.hidden = !open;
    menuBtn.setAttribute('aria-expanded', String(open));
  });
  menu?.addEventListener('click', (e) => {
    if (e.target.closest('a')) {
      menu.hidden = true;
      menuBtn?.setAttribute('aria-expanded', 'false');
    }
  });

  // Pastille du panier
  function refreshCount() {
    let cart = [];
    try { cart = JSON.parse(localStorage.getItem('sks_cart') || '[]'); } catch { cart = []; }
    const total = cart.reduce((sum, item) => sum + item.qty, 0);
    const badge = document.getElementById('cart-count');
    if (!badge) return;
    badge.textContent = String(total);
    badge.hidden = total === 0;
  }

  refreshCount();
  window.addEventListener('sks:cart-updated', refreshCount);

  document.getElementById('cart-open')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('sks:cart-open'));
  });
</script>
