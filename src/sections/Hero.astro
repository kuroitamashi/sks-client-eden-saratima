---
/* Bannière Hero Pleine Largeur (Full-Width).
 *
 *  - Image en pleine largeur (full bleed) avec dégradé subtil
 *  - Contenu éditorial aligné à gauche dans le container
 *  - Boutons avec angles vifs (border-radius: 0, respect strict de la charte Taaru)
 *  - Contrôles du slider positionnés à gauche, sans encadrement (épurés)
 *  - Flèches horizontales (← | →)
 *  - Défilement automatique toutes les 5 secondes avec barre de progression animée
 *  - Pause automatique au survol et au focus clavier
 *  - Support tactile (swipe) et clavier (flèches)
 */
import { getContent } from '../lib/theme.js';

const content = await getContent();
const defaultImages = [
  '/hero/hero-soin-visage.jpg',
  '/hero/hero-maquillage.jpg',
  '/hero/hero-corps-cheveux.jpg',
];
const volets = (content.hero?.volets && content.hero.volets.length > 0)
  ? content.hero.volets
  : [
      {
        fond: 'surface',
        grandTitre: 'SOIN DU VISAGE',
        surtitre: 'Rituel quotidien',
        titre: 'Une peau qu’on écoute',
        texte: 'Des formules courtes, choisies pour le climat de Dakar : la chaleur, la poussière, le soleil. On te dit à quoi sert chaque produit et à quel moment le mettre.',
        cta: 'Voir les soins',
        href: '/produits/?rayon=soin-visage',
        bgImage: '/hero/hero-soin-visage.jpg',
      },
      {
        fond: 'primary',
        grandTitre: 'MAQUILLAGE',
        surtitre: 'Teint & Lèvres',
        titre: 'Des teintes faites pour nous',
        texte: 'Du fond de teint au rouge à lèvres, une gamme pensée pour les peaux noires et métissées. Choisis ta teinte, elle part avec ta commande.',
        cta: 'Voir le maquillage',
        href: '/produits/?rayon=maquillage',
        bgImage: '/hero/hero-maquillage.jpg',
      },
      {
        fond: 'accent',
        grandTitre: 'CORPS & CHEVEUX',
        surtitre: 'Artisanat & Pureté',
        titre: 'Le karité, sans détour',
        texte: 'Beurre de karité, huiles et savons. Ce qui se fait ici depuis toujours, présenté comme il le mérite.',
        cta: 'Voir le rayon',
        href: '/produits/?rayon=corps-cheveux',
        bgImage: '/hero/hero-corps-cheveux.jpg',
      },
    ];
---

<section
  class="hero-full"
  id="hero-full"
  role="region"
  aria-roledescription="carrousel"
  aria-label="Sélections de la boutique"
>
  <div class="hero-full__slides" id="hero-slides">
    {volets.map((volet, i) => (
      <article
        class="hero-full__slide"
        data-index={i}
        data-actif={i === 0 ? 'true' : 'false'}
        aria-hidden={i === 0 ? 'false' : 'true'}
      >
        {/* IMAGE PLEINE LARGEUR EN ARRIÈRE-PLAN */}
        <div class="hero-full__media">
          <img
            src={volet.bgImage || volet.image || defaultImages[i % defaultImages.length]}
            alt=""
            class="hero-full__img"
            loading={i === 0 ? 'eager' : 'lazy'}
            decoding="async"
            aria-hidden="true"
          />
          <div class="hero-full__overlay"></div>
        </div>

        {/* CONTENU ALIGNÉ DANS LE CONTAINER */}
        <div class="container hero-full__container">
          <div class="hero-full__content">
            <p class="hero-full__surtitre">{volet.surtitre || 'RITUEL'}</p>
            <h1 class="hero-full__titre">{volet.grandTitre || volet.titre}</h1>
            <p class="hero-full__texte">{volet.texte}</p>
            <div class="hero-full__actions">
              <a
                href={volet.href}
                class="hero-full__cta"
                tabindex={i === 0 ? 0 : -1}
              >
                <span>{volet.cta}</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </article>
    ))}
  </div>

  {/* CONTRÔLES DU SLIDER : À GAUCHE, SANS ENCADREMENT */}
  <div class="container hero-full__controls-container">
    <div class="hero-full__controls">
      {/* Compteur 01 / 03 */}
      <div class="hero-full__counter" aria-live="polite">
        <span class="hero-full__current" id="hero-current-num">01</span>
        <span class="hero-full__counter-sep">/</span>
        <span class="hero-full__total">0{volets.length}</span>
      </div>

      {/* Barre de progression 5s */}
      <div
        class="hero-full__progress-track"
        role="progressbar"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-label="Temps avant le slide suivant"
      >
        <div class="hero-full__progress-bar" id="hero-progress-bar"></div>
      </div>

      {/* Flèches gauche et droite (← | →) */}
      <div class="hero-full__arrows">
        <button
          type="button"
          class="hero-full__arrow"
          id="hero-prev"
          aria-label="Slide précédent"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M19 12H5M12 19l-7-7 7-7" />
          </svg>
        </button>
        <span class="hero-full__arrow-sep" aria-hidden="true">|</span>
        <button
          type="button"
          class="hero-full__arrow"
          id="hero-next"
          aria-label="Slide suivant"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  /* ====================================================================
   * Section Full-Width
   * ================================================================== */
  .hero-full {
    position: relative;
    width: 100%;
    padding-block: 0 !important;
    background: var(--color-text, #1F1418);
    color: #ffffff;
    overflow: hidden;
    height: calc(100vh - 98px);
    min-height: 520px;
    max-height: 840px;
    display: flex;
    flex-direction: column;
  }

  .hero-full__slides {
    position: relative;
    flex: 1;
    width: 100%;
    height: 100%;
  }

  /* Slide individuel */
  .hero-full__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1),
                visibility 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 1;
    display: flex;
    align-items: center;
  }

  .hero-full__slide[data-actif="true"] {
    opacity: 1;
    visibility: visible;
    z-index: 2;
  }

  /* Visuel plein écran avec overlay sombre cinématographique */
  .hero-full__media {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .hero-full__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    transform: scale(1.04);
    transition: transform 8s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .hero-full__slide[data-actif="true"] .hero-full__img {
    transform: scale(1);
  }

  .hero-full__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      rgba(31, 20, 24, 0.82) 0%,
      rgba(31, 20, 24, 0.50) 45%,
      rgba(31, 20, 24, 0.25) 100%
    );
  }

  @media (max-width: 768px) {
    .hero-full__overlay {
      background: linear-gradient(
        to bottom,
        rgba(31, 20, 24, 0.40) 0%,
        rgba(31, 20, 24, 0.80) 100%
      );
    }
  }

  /* ====================================================================
   * Contenu texte aligné à gauche
   * ================================================================== */
  .hero-full__container {
    position: relative;
    z-index: 3;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-bottom: 5rem; /* espace réservé aux contrôles */
  }

  .hero-full__content {
    max-width: 48rem;
  }

  .hero-full__surtitre {
    font-size: clamp(0.75rem, 1.2vw, 0.88rem);
    letter-spacing: 0.28em;
    font-weight: 500;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: var(--space-4);
    transform: translateY(16px);
    opacity: 0;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.1s, opacity 0.8s ease 0.1s;
  }

  .hero-full__titre {
    font-family: var(--font-display, inherit);
    font-size: clamp(2.4rem, 5.5vw, 4.8rem);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.08;
    color: #ffffff;
    margin-bottom: var(--space-5);
    transform: translateY(24px);
    opacity: 0;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.2s, opacity 0.8s ease 0.2s;
  }

  .hero-full__texte {
    font-size: clamp(0.95rem, 1.3vw, 1.1rem);
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.88);
    max-width: 44ch;
    margin-bottom: var(--space-8);
    transform: translateY(20px);
    opacity: 0;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.3s, opacity 0.8s ease 0.3s;
  }

  .hero-full__actions {
    transform: translateY(16px);
    opacity: 0;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.4s, opacity 0.8s ease 0.4s;
  }

  .hero-full__slide[data-actif='true'] .hero-full__surtitre,
  .hero-full__slide[data-actif='true'] .hero-full__titre,
  .hero-full__slide[data-actif='true'] .hero-full__texte,
  .hero-full__slide[data-actif='true'] .hero-full__actions {
    transform: translateY(0);
    opacity: 1;
  }

  /* Bouton avec ANGLES VIFS (border-radius: 0 - charte Taaru) */
  .hero-full__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.95rem 2.5rem;
    border-radius: 0 !important; /* Aucun arrondi */
    background: #ffffff;
    color: var(--color-text, #1F1418);
    border: none;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color var(--duration-fast) var(--ease-out),
                color var(--duration-fast) var(--ease-out),
                transform var(--duration-fast) var(--ease-out);
  }

  .hero-full__cta:hover {
    background: var(--color-accent, #78253E);
    color: #ffffff;
    transform: translateY(-2px);
  }

  .hero-full__cta svg {
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .hero-full__cta:hover svg {
    transform: translateX(4px);
  }

  .hero-full__cta:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 3px;
  }

  /* ====================================================================
   * Contrôles : À GAUCHE, SANS ENCADREMENT
   * ================================================================== */
  .hero-full__controls-container {
    position: absolute;
    bottom: 1.6rem;
    left: 0;
    right: 0;
    z-index: 10;
    pointer-events: none;
  }

  .hero-full__controls {
    display: inline-flex;
    align-items: center;
    gap: 1.25rem;
    pointer-events: auto;
    background: none;
    border: none;
    padding: 0;
  }

  /* Compteur 01 / 03 */
  .hero-full__counter {
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
    font-family: var(--font-display, inherit);
    font-size: 0.88rem;
    font-weight: 600;
    color: #ffffff;
    letter-spacing: 0.1em;
  }

  .hero-full__counter-sep {
    font-size: 0.75rem;
    opacity: 0.45;
  }

  .hero-full__total {
    font-size: 0.75rem;
    opacity: 0.6;
  }

  /* Barre de progression fluide 5s */
  .hero-full__progress-track {
    width: clamp(80px, 12vw, 130px);
    height: 2px;
    background: rgba(255, 255, 255, 0.25);
    border-radius: 0;
    overflow: hidden;
    position: relative;
  }

  .hero-full__progress-bar {
    width: 0%;
    height: 100%;
    background: #ffffff;
    border-radius: 0;
    will-change: width;
  }

  /* Flèches gauche et droite (← | →) */
  .hero-full__arrows {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .hero-full__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 0;
    border: none;
    background: transparent;
    color: #ffffff;
    cursor: pointer;
    opacity: 0.85;
    transition: opacity 0.2s ease, transform 0.2s ease;
    padding: 0;
  }

  .hero-full__arrow:hover {
    opacity: 1;
    transform: scale(1.12);
  }

  .hero-full__arrow:active {
    transform: scale(0.92);
  }

  .hero-full__arrow:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 2px;
  }

  .hero-full__arrow-sep {
    color: rgba(255, 255, 255, 0.35);
    font-size: 0.85rem;
    line-height: 1;
  }

  /* Accessibilité reduced-motion */
  @media (prefers-reduced-motion: reduce) {
    .hero-full__slide,
    .hero-full__img,
    .hero-full__surtitre,
    .hero-full__titre,
    .hero-full__texte,
    .hero-full__actions {
      transition: none !important;
    }
  }
</style>

<script>
  function initHeroSlider() {
    const root = document.getElementById('hero-full');
    if (!root) return;

    const slides = [...root.querySelectorAll<HTMLElement>('.hero-full__slide')];
    const prevBtn = document.getElementById('hero-prev');
    const nextBtn = document.getElementById('hero-next');
    const currentNumEl = document.getElementById('hero-current-num');
    const progressBar = document.getElementById('hero-progress-bar');

    if (slides.length === 0) return;

    let currentIndex = 0;
    const DURATION = 5000; // 5 secondes
    let progressStartTime = performance.now();
    let animFrameId: number | null = null;
    let isPaused = false;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function goToSlide(newIndex: number) {
      currentIndex = (newIndex + slides.length) % slides.length;

      slides.forEach((slide, idx) => {
        const isActif = idx === currentIndex;
        slide.dataset.actif = String(isActif);
        slide.setAttribute('aria-hidden', String(!isActif));

        const cta = slide.querySelector<HTMLAnchorElement>('.hero-full__cta');
        if (cta) cta.tabIndex = isActif ? 0 : -1;
      });

      if (currentNumEl) {
        currentNumEl.textContent = `0${currentIndex + 1}`;
      }

      resetProgress();
    }

    function resetProgress() {
      progressStartTime = performance.now();
      if (progressBar) {
        progressBar.style.width = '0%';
      }
    }

    function tick(now: number) {
      if (!isPaused && !prefersReducedMotion && slides.length > 1) {
        const elapsed = now - progressStartTime;
        const progress = Math.min(elapsed / DURATION, 1);

        if (progressBar) {
          progressBar.style.width = `${progress * 100}%`;
        }

        if (progress >= 1) {
          goToSlide(currentIndex + 1);
        }
      } else if (isPaused) {
        progressStartTime = now - ((parseFloat(progressBar?.style.width || '0') / 100) * DURATION);
      }

      animFrameId = requestAnimationFrame(tick);
    }

    prevBtn?.addEventListener('click', () => {
      goToSlide(currentIndex - 1);
    });

    nextBtn?.addEventListener('click', () => {
      goToSlide(currentIndex + 1);
    });

    root.addEventListener('mouseenter', () => { isPaused = true; });
    root.addEventListener('mouseleave', () => { isPaused = false; });
    root.addEventListener('focusin', () => { isPaused = true; });
    root.addEventListener('focusout', () => { isPaused = false; });

    root.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowLeft') {
        goToSlide(currentIndex - 1);
      } else if (e.key === 'ArrowRight') {
        goToSlide(currentIndex + 1);
      }
    });

    let touchStartX = 0;
    root.addEventListener('touchstart', (e: TouchEvent) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    root.addEventListener('touchend', (e: TouchEvent) => {
      const touchEndX = e.changedTouches[0].screenX;
      const diff = touchEndX - touchStartX;
      if (Math.abs(diff) > 40) {
        if (diff < 0) {
          goToSlide(currentIndex + 1);
        } else {
          goToSlide(currentIndex - 1);
        }
      }
    }, { passive: true });

    document.addEventListener('visibilitychange', () => {
      isPaused = document.hidden;
    });

    goToSlide(0);
    animFrameId = requestAnimationFrame(tick);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroSlider);
  } else {
    initHeroSlider();
  }
</script>
