---
import Default from '../layouts/Default.astro';
import Hero from '../sections/Hero.astro';
import Benefits from '../sections/Benefits.astro';
import CatalogRails from '../sections/CatalogRails.astro';
import ProductFocus from '../sections/ProductFocus.astro';
import Reviews from '../sections/Reviews.astro';
import Faq from '../sections/Faq.astro';
import Reassurance from '../sections/Reassurance.astro';
---

<Default>
  <Hero />
  <Benefits />
  {/* Ces deux sections sont les SEULES de l'accueil a dependre du catalogue.
      server:defer les sort de la page figee : le reste (banniere, FAQ,
      avis) part instantanement depuis le cache, puis ces deux blocs se
      remplissent avec le catalogue du moment. Le slot fallback reserve la
      place pour que la page ne saute pas quand ils arrivent. */}
  <CatalogRails server:defer>
    <div slot="fallback" class="attente attente--rangees" aria-hidden="true"></div>
  </CatalogRails>
  <ProductFocus server:defer>
    <div slot="fallback" class="attente attente--focus" aria-hidden="true"></div>
  </ProductFocus>
  <Reviews />
  <Faq />
  <Reassurance />
</Default>

<style>
  .attente--rangees { min-height: 36rem; }
  .attente--focus { min-height: 28rem; }
</style>
