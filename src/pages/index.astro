---
import Default from '../layouts/Default.astro';
import Hero from '../sections/Hero.astro';
import Benefits from '../sections/Benefits.astro';
import CatalogRails from '../sections/CatalogRails.astro';
import ProductFocus from '../sections/ProductFocus.astro';
import Reviews from '../sections/Reviews.astro';
import Faq from '../sections/Faq.astro';
import Reassurance from '../sections/Reassurance.astro';
import { listProducts, getFeaturedProduct } from '../lib/products.js';

/* Un seul appel au catalogue pour toute la page. Les rangees et le rituel du
   moment lisent la meme liste : impossible que la mise en avant annonce un
   produit que les rangees ne contiennent pas.

   La banniere, elle, ne lit PAS le catalogue : ses trois volets sont
   editoriaux et vivent dans theme.config.js. */
const produits = await listProducts();
const focus = await getFeaturedProduct();
---

<Default>
  <Hero />
  <Benefits />
  <CatalogRails produits={produits} />
  <ProductFocus product={focus} />
  <Reviews />
  <Faq />
  <Reassurance />
</Default>
