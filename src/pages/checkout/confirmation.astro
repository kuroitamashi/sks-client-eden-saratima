---
import { getTheme } from '../../lib/theme.js';
import type { BrandingTokens, Order } from '@sks/checkout/index.js';
import OrderConfirmationPage from '@sks/checkout/ui/pages/OrderConfirmationPage.astro';

export const prerender = false;

const theme = await getTheme();
const orderParam = Astro.url.searchParams.get('order');

let order: Order | null = null;
if (orderParam) {
  try {
    const jsonStr = Buffer.from(orderParam, 'base64url').toString('utf-8');
    order = JSON.parse(jsonStr);
  } catch (e) {
    console.error('Erreur décodage order:', e);
  }
}

const tokens: BrandingTokens = {
  storeName: theme.identity.name,
  storeUrl: '/',
  supportPhone: theme.identity.whatsapp,
  supportWhatsApp: theme.identity.whatsapp,
  supportEmail: theme.identity.email || 'contact@edensaratima.sn',
  colors: {
    accent: theme.colors.accent || '#78253E',
    background: theme.colors.bg || '#FFFFFF',
    surface: theme.colors.surface || '#FBF4F6',
    text: theme.colors.text || '#1F1418',
    mutedText: theme.colors.secondary || '#947F87',
    border: '#E5E7EB',
  },
  typography: {
    fontDisplay: "'Plus Jakarta Sans', sans-serif",
    fontBody: "'Plus Jakarta Sans', sans-serif",
  },
  radius: 'md',
};

if (!order) {
  return Astro.redirect('/');
}
---

<OrderConfirmationPage tokens={tokens} order={order} />
