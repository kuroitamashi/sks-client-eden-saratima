# Source des produits : "fixture" (donnees de demonstration) ou "surecart".
DATA_SOURCE=fixture

# SureCart : la cle API SureCart du marchand (si DATA_SOURCE=surecart)
SC_SECRET_KEY=sk_xxxxxxxx

# URL publique du site, utilisee pour les metadonnees Open Graph et le sitemap.
PUBLIC_BASE_URL=https://eden-saratima.senkheweulstore.com

# Branchement direct sur l'API Sen Kheweul Store (thème, couleurs, checkout Dakar)
PUBLIC_SKS_API_URL=https://app.senkheweulstore.com
PUBLIC_SKS_BOUTIQUE_SLUG=eden-saratima

# Indexation moteurs de recherche (true en production)
SITE_INDEXABLE=true

